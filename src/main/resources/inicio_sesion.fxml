<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="6" styleClass="login-fondo" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utj.evnd.poo.bibliotecaproyec.controller.LoginController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>
    <Label text="Sistema de Biblioteca" styleClass="login-titulo"/>
    <Label text="Acceso restringido al personal autorizado" styleClass="aviso"/>
    <VBox spacing="6" maxWidth="Infinity" styleClass="login-tarjeta">
        <padding>
            <Insets top="22" right="22" bottom="22" left="22"/>
        </padding>
        <Label text="ID o correo electrónico" styleClass="subtitulo"/>
        <TextField fx:id="txtIdentificador" promptText="1  o  usuario@dominio.com"/>
        <Label text="Contraseña" styleClass="subtitulo">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Label>
        <PasswordField fx:id="txtContrasena" promptText="Contraseña"/>
        <Label fx:id="lblError" styleClass="error-label" wrapText="true" minHeight="34" maxWidth="Infinity"/>
        <Button fx:id="btnIngresar" text="Iniciar sesión" onAction="#onIngresar" defaultButton="true" maxWidth="Infinity" styleClass="boton-primario"/>
    </VBox>
    <Label text="Joshua Odin Montoya Flores" styleClass="aviso">
        <VBox.margin>
            <Insets top="14"/>
        </VBox.margin>
    </Label>
</VBox>
